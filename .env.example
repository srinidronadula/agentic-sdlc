# Copy to .env and fill in. Never commit .env.

# LLM (implement/test agents). Anthropic is the default for this prototype.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Set to 1 to force stub agents (no Anthropic calls) for UI demos.
# AGENTIC_STUB=1

# OPENAI_API_KEY=

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
